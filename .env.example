# ---- Server ----
PORT=3000
NODE_ENV=production
# Comma-separated list of origins allowed to call this API (your GPT-built front-end's domain)
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:8080

# ---- Anthropic (extraction + Green/Yellow reasoning) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ---- Web search provider (pick one; SerpAPI shown as default) ----
SEARCH_PROVIDER=serpapi
SERPAPI_KEY=your_serpapi_key

# ---- Google Sheets logging ----
# Create a Google Cloud service account, enable Sheets API, share the target
# Sheet with the service account's email address (Editor access).
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines (Railway env vars are single-line)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_from_the_url

# ---- Free tier limits ----
FREE_SCANS_PER_MONTH=5
